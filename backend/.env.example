DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=dhara

# Google Identity Services OAuth client (Web application)
GOOGLE_CLIENT_ID=
# Local only: show a "dev sign-in" form on the login page (requires DEBUG)
DEV_LOGIN_ENABLED=true

FRONTEND_URL=http://localhost:5173
TUS_PUBLIC_ENDPOINT=http://localhost:5173/upload/
UPLOAD_DIR=../var/uploads
MIN_FREE_DISK_BYTES=536870912

# Edge Worker (wrangler dev locally, vid.<domain> in production)
EDGE_PUBLIC_URL=http://localhost:8787
EDGE_INTERNAL_URL=http://localhost:8787
EDGE_INTERNAL_SECRET=
# Shared with tusd hooks and encoderd
INTERNAL_SECRET=

AUTO_APPROVE_TRIALS=true
